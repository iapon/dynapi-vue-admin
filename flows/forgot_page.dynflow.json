t\" action=\"/forgot\">\n      <label for=\"email\">Email</label>\n      <input id=\"email\" name=\"email\" type=\"email\" required autocomplete=\"email\">\n      <button type=\"submit\">Отправить ссылку</button>\n    </form>\n    <div class=\"links\">\n      <a href=\"/login\">Вернуться ко входу</a>\n    </div>\n  </div>\n</body>\n</html>\n"
