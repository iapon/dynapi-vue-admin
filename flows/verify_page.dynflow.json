{
  "format": "dynapi-flow",
  "version": 1,
  "exportedAt": "2026-09-08T00:00:00.000Z",
  "handle": {
    "slug": "verify_page",
    "name": "Verify page",
    "enabled_cors": false,
    "allowed_origins": []
  },
  "routes": [
    {
      "path": "/verify",
      "methods": [
        "GET"
      ],
      "cache": {
        "defaultTtl": 0
      },
      "flows": [
        {
          "handle": "verify_page",
          "methods": [
            "GET"
          ]
        }
      ]
    }
  ],
  "flow": {
    "version": 2,
    "nodes": [
      {
        "id": "n_start",
        "type": "entry",
        "data": {}
      },
      {
        "id": "a_fetch",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "continue",
          "config": {
            "query": "query($id: ID!) {\n  member(id: $id) {\n    id password\n  }\n}",
            "variables": {
              "id": "{{ token_subject }}"
            },
            "result_key": "m",
            "secret_vars": [
              "password"
            ]
          }
        }
      },
      {
        "id": "c_valid",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "query.token",
                "operator": "token_valid",
                "value": "verify|{{results.m.member.password}}"
              }
            ]
          }
        }
      },
      {
        "id": "a_flag",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "continue",
          "config": {
            "query": "mutation($id: ID!, $flag: Boolean!) {\n  updateMember(id: $id, input: {verified: $flag}) {\n    id\n  }\n}",
            "variables": {
              "id": "{{ token_subject }}",
              "flag": true
            }
          }
        }
      },
      {
        "id": "a_cookie",
        "type": "action",
        "data": {
          "action_type": "set_cookie",
          "on_error": "continue",
          "config": {
            "name": "member",
            "value": "{\"id\":\"{{results.m.member.id}}\"}",
            "ttl_days": 30,
            "path": "/",
            "session": true
          }
        }
      },
      {
        "id": "a_ok",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/login?verified=1",
            "status": 303
          }
        }
      },
      {
        "id": "a_fail",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/login?verified=invalid",
            "status": 303
          }
        }
      }
    ],
    "edges": [
      {
        "from": "n_start",
        "to": "a_fetch",
        "branch": ""
      },
      {
        "from": "a_fetch",
        "to": "c_valid",
        "branch": ""
      },
      {
        "from": "c_valid",
        "to": "a_flag",
        "branch": "then"
      },
      {
        "from": "a_flag",
        "to": "a_cookie",
        "branch": ""
      },
      {
        "from": "a_cookie",
        "to": "a_ok",
        "branch": ""
      },
      {
        "from": "c_valid",
        "to": "a_fail",
        "branch": "else"
      }
    ]
  },
  "queries": [],
  "templates": []
}
