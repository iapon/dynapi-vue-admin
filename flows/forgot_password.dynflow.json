{
  "format": "dynapi-flow",
  "version": 1,
  "exportedAt": "2026-09-08T00:00:00.000Z",
  "handle": {
    "slug": "forgot_password",
    "name": "Forgot password",
    "enabled_cors": false,
    "allowed_origins": []
  },
  "routes": [
    {
      "path": "/forgot",
      "methods": [
        "POST"
      ],
      "cache": {
        "defaultTtl": 0
      },
      "flows": [
        {
          "handle": "forgot_password",
          "methods": [
            "POST"
          ]
        }
      ]
    }
  ],
  "flow": {
    "version": 2,
    "nodes": [
      {
        "id": "n_start",
        "type": "entry",
        "data": {}
      },
      {
        "id": "a_fetch",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "continue",
          "config": {
            "query": "query($q: String!) {\n  members(where: {email: {eq: $q}}, limit: 1) {\n    id password\n  }\n}",
            "variables": {
              "q": "{{form.email}}"
            },
            "result_key": "m",
            "secret_vars": [
              "password"
            ]
          }
        }
      },
      {
        "id": "a_mail",
        "type": "action",
        "data": {
          "action_type": "send_email",
          "on_error": "continue",
          "config": {
            "to": [
              "{{form.email}}"
            ],
            "subject": "Сброс пароля — каталог библиотеки",
            "body_template": "Здравствуйте!\n\nСбросить пароль можно по ссылке (действует 1 час):\nhttps://biblio.dynapi.ru/reset?token={{ results.m.members[0].password | signed_token: results.m.members[0].id, \"reset\", 3600 }}\n\nЕсли вы не запрашивали сброс — просто игнорируйте это письмо, пароль не изменится.",
            "smtp": {
              "host": "mail.dynapi.ru",
              "port": 587,
              "username": "biblio@dynapi.ru",
              "password": "secret://biblio-smtp-password",
              "from": "biblio@dynapi.ru",
              "from_name": "Каталог библиотеки"
            }
          }
        }
      },
      {
        "id": "a_ok",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/login?reset=sent",
            "status": 303
          }
        }
      }
    ],
    "edges": [
      {
        "from": "n_start",
        "to": "a_fetch",
        "branch": ""
      },
      {
        "from": "a_fetch",
        "to": "a_mail",
        "branch": ""
      },
      {
        "from": "a_mail",
        "to": "a_ok",
        "branch": ""
      }
    ]
  },
  "queries": [],
  "templates": []
}
