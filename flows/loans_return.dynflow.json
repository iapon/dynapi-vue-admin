{
  "format": "dynapi-flow",
  "version": 1,
  "exportedAt": "2026-09-10T00:00:00.000Z",
  "handle": {
    "slug": "loans_return",
    "name": "Loans return",
    "enabled_cors": false,
    "allowed_origins": []
  },
  "routes": [
    {
      "path": "/api/loans/return",
      "methods": ["POST"],
      "cache": { "defaultTtl": 0 },
      "membersOnly": true,
      "loginPath": "/login",
      "flows": [{ "handle": "loans_return", "methods": ["POST"] }]
    }
  ],
  "flow": {
    "version": 2,
    "nodes": [
      { "id": "n_start", "type": "entry", "data": {} },
      {
        "id": "c_id",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              { "field": "json.loan_id", "operator": "matches", "value": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
            ]
          }
        }
      },
      {
        "id": "a_upd",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "continue",
          "config": {
            "query": "mutation($id: ID!) {\n  updateLoan(id: $id, input: {status: \"returned\"}) {\n    id status\n  }\n}",
            "variables": {
              "id": "{{json.loan_id}}"
            },
            "result_key": "upd"
          }
        }
      },
      {
        "id": "c_done",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              { "field": "results.upd.updateLoan.id", "operator": "matches", "value": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
            ]
          }
        }
      },
      {
        "id": "a_ok",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 200,
            "body_template": "{\"ok\": true}"
          }
        }
      },
      {
        "id": "a_nf",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 404,
            "body_template": "{\"error\": \"NOT_FOUND\"}"
          }
        }
      },
      {
        "id": "a_e_id",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 400,
            "body_template": "{\"error\": \"VALIDATION\", \"field\": \"loan_id\"}"
          }
        }
      }
    ],
    "edges": [
      { "from": "n_start", "to": "c_id", "branch": "" },
      { "from": "c_id", "to": "a_upd", "branch": "then" },
      { "from": "c_id", "to": "a_e_id", "branch": "else" },
      { "from": "a_upd", "to": "c_done", "branch": "" },
      { "from": "c_done", "to": "a_ok", "branch": "then" },
      { "from": "c_done", "to": "a_nf", "branch": "else" }
    ]
  }
}
