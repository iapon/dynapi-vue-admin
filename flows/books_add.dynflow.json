{
  "format": "dynapi-flow",
  "version": 1,
  "exportedAt": "2026-09-08T00:00:00.000Z",
  "handle": {
    "slug": "books_add",
    "name": "Books add",
    "enabled_cors": false,
    "allowed_origins": []
  },
  "routes": [
    {
      "path": "/api/books/add",
      "methods": [
        "POST"
      ],
      "cache": {
        "defaultTtl": 0
      },
      "membersOnly": true,
      "loginPath": "/login",
      "flows": [
        {
          "handle": "books_add",
          "methods": [
            "POST"
          ]
        }
      ]
    }
  ],
  "flow": {
    "version": 2,
    "nodes": [
      {
        "id": "n_start",
        "type": "entry",
        "data": {}
      },
      {
        "id": "c_title",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "json.title",
                "operator": "matches",
                "value": "\\S"
              }
            ]
          }
        }
      },
      {
        "id": "c_author",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "json.author",
                "operator": "matches",
                "value": "\\S"
              }
            ]
          }
        }
      },
      {
        "id": "c_year_present",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "json.year",
                "operator": "ne",
                "value": ""
              }
            ]
          }
        }
      },
      {
        "id": "c_year_range",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "json.year",
                "operator": "matches",
                "value": "^\\d{4}$"
              },
              {
                "field": "json.year",
                "operator": "gt",
                "value": "1800"
              },
              {
                "field": "json.year",
                "operator": "lt",
                "value": "2100"
              }
            ]
          }
        }
      },
      {
        "id": "c_cover_present",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "json.cover",
                "operator": "ne",
                "value": ""
              }
            ]
          }
        }
      },
      {
        "id": "c_cover_shape",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "json.cover",
                "operator": "matches",
                "value": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            ]
          }
        }
      },
      {
        "id": "a_create",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "stop",
          "config": {
            "query": "mutation($title: String!, $author: String!, $year: Int, $status: String, $cover: ID) {\n  createBook(input: {title: $title, author: $author, year: $year, status: $status, cover: $cover}) {\n    id title author year status\n    cover { id url }\n  }\n}",
            "variables": {
              "title": "{{json.title | strip}}",
              "author": "{{json.author | strip}}",
              "year": "{% if json.year == blank %}{% else %}{{ json.year | strip | plus: 0 }}{% endif %}",
              "status": "{{json.status | default: \"in_stock\"}}",
              "cover": "{{json.cover}}"
            },
            "result_key": "created",
            "secret_vars": []
          }
        }
      },
      {
        "id": "a_out",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 201,
            "body_template": "{\"book\": {{ results.created.createBook | json }}}"
          }
        }
      },
      {
        "id": "a_err_cover",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 400,
            "body_template": "{\"error\": \"VALIDATION\", \"field\": \"cover\", \"message\": \"Обложка — id записи из медиатеки или пусто\"}"
          }
        }
      },
      {
        "id": "a_err_title",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 400,
            "body_template": "{\"error\": \"VALIDATION\", \"field\": \"title\", \"message\": \"Укажите название\"}"
          }
        }
      },
      {
        "id": "a_err_author",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 400,
            "body_template": "{\"error\": \"VALIDATION\", \"field\": \"author\", \"message\": \"Укажите автора\"}"
          }
        }
      },
      {
        "id": "a_err_year",
        "type": "action",
        "data": {
          "action_type": "respond_json",
          "on_error": "continue",
          "config": {
            "status": 400,
            "body_template": "{\"error\": \"VALIDATION\", \"field\": \"year\", \"message\": \"Год должен быть числом от 1800 до 2100\"}"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "n_start",
        "to": "c_title",
        "branch": ""
      },
      {
        "from": "c_title",
        "to": "c_author",
        "branch": "then"
      },
      {
        "from": "c_title",
        "to": "a_err_title",
        "branch": "else"
      },
      {
        "from": "c_author",
        "to": "c_year_present",
        "branch": "then"
      },
      {
        "from": "c_author",
        "to": "a_err_author",
        "branch": "else"
      },
      {
        "from": "c_year_present",
        "to": "c_year_range",
        "branch": "then"
      },
      {
        "from": "c_year_present",
        "to": "c_cover_present",
        "branch": "else"
      },
      {
        "from": "c_year_range",
        "to": "c_cover_present",
        "branch": "then"
      },
      {
        "from": "c_year_range",
        "to": "a_err_year",
        "branch": "else"
      },
      {
        "from": "c_cover_present",
        "to": "c_cover_shape",
        "branch": "then"
      },
      {
        "from": "c_cover_present",
        "to": "a_create",
        "branch": "else"
      },
      {
        "from": "c_cover_shape",
        "to": "a_create",
        "branch": "then"
      },
      {
        "from": "c_cover_shape",
        "to": "a_err_cover",
        "branch": "else"
      },
      {
        "from": "a_create",
        "to": "a_out",
        "branch": ""
      }
    ]
  },
  "queries": [],
  "templates": []
}