{
  "format": "dynapi-flow",
  "version": 1,
  "exportedAt": "2026-09-08T00:00:00.000Z",
  "handle": {
    "slug": "login",
    "name": "Login",
    "enabled_cors": false,
    "allowed_origins": []
  },
  "routes": [
    {
      "path": "/login",
      "methods": [
        "POST"
      ],
      "cache": {
        "defaultTtl": 0
      },
      "flows": [
        {
          "handle": "login",
          "methods": [
            "POST"
          ]
        }
      ]
    }
  ],
  "flow": {
    "version": 2,
    "nodes": [
      {
        "id": "n_start",
        "type": "entry",
        "data": {}
      },
      {
        "id": "a_fetch",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "continue",
          "config": {
            "query": "query($q: String!) {\n  members(where: {email: {eq: $q}}, limit: 1) {\n    id email password verified name role\n  }\n}",
            "variables": {
              "q": "{{form.email}}"
            },
            "result_key": "login",
            "secret_vars": [
              "password"
            ]
          }
        }
      },
      {
        "id": "c_check",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "form.password",
                "operator": "bcrypt_matches",
                "value": "{{results.login.members[0].password}}"
              }
            ]
          }
        }
      },
      {
        "id": "c_verified",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "results.login.members[0].verified",
                "operator": "eq",
                "value": "true"
              }
            ]
          }
        }
      },
      {
        "id": "a_cookie",
        "type": "action",
        "data": {
          "action_type": "set_cookie",
          "on_error": "continue",
          "config": {
            "name": "member",
            "value": "{\"id\":\"{{results.login.members[0].id}}\",\"name\":{{results.login.members[0].name | json}},\"role\":\"{{results.login.members[0].role}}\"}",
            "ttl_days": 30,
            "path": "/",
            "session": true
          }
        }
      },
      {
        "id": "a_ok",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/admin",
            "status": 303
          }
        }
      },
      {
        "id": "a_unverified",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/login?unverified=1",
            "status": 303
          }
        }
      },
      {
        "id": "a_fail",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/login?failed=1",
            "status": 303
          }
        }
      }
    ],
    "edges": [
      {
        "from": "n_start",
        "to": "a_fetch",
        "branch": ""
      },
      {
        "from": "a_fetch",
        "to": "c_check",
        "branch": ""
      },
      {
        "from": "c_check",
        "to": "c_verified",
        "branch": "then"
      },
      {
        "from": "c_verified",
        "to": "a_cookie",
        "branch": "then"
      },
      {
        "from": "a_cookie",
        "to": "a_ok",
        "branch": ""
      },
      {
        "from": "c_verified",
        "to": "a_unverified",
        "branch": "else"
      },
      {
        "from": "c_check",
        "to": "a_fail",
        "branch": "else"
      }
    ]
  },
  "queries": [],
  "templates": []
}
