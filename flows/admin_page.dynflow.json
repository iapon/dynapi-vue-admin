{
  "format": "dynapi-flow",
  "version": 1,
  "exportedAt": "2026-09-08T00:00:00.000Z",
  "handle": {
    "slug": "admin_page",
    "name": "Admin page",
    "enabled_cors": false,
    "allowed_origins": []
  },
  "routes": [
    {
      "path": "/admin",
      "methods": [
        "GET"
      ],
      "cache": {
        "defaultTtl": 0
      },
      "membersOnly": true,
      "loginPath": "/login",
      "flows": [
        {
          "handle": "admin_page",
          "methods": [
            "GET"
          ]
        }
      ]
    }
  ],
  "flow": {
    "version": 2,
    "nodes": [
      {
        "id": "n_start",
        "type": "entry",
        "data": {}
      },
      {
        "id": "a_me",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "continue",
          "config": {
            "query": "query($id: ID!) {\n  members(where: {id: {eq: $id}}, limit: 1) {\n    id email\n  }\n}",
            "variables": {
              "id": "{{ member.id }}"
            },
            "result_key": "me",
            "secret_vars": []
          }
        }
      },
      {
        "id": "a_render",
        "type": "action",
        "data": {
          "action_type": "render",
          "on_error": "continue",
          "config": {
            "template": "admin.liquid"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "n_start",
        "to": "a_me",
        "branch": ""
      },
      {
        "from": "a_me",
        "to": "a_render",
        "branch": ""
      }
    ]
  },
  "queries": [],
  "templates": [
    {
      "path": "admin.liquid",
      "content": "<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Каталог — Библиотека</title>\n  <link rel=\"stylesheet\" href=\"/static/admin.css?v={{ site.version }}\">\n</head>\n<body>\n  <div id=\"app\"></div>\n  <script>\n    // Boot payload: собран сервером до рендера шаблона.\n    // member — сессия из куки, email — результат graphql-узла сценария.\n    window.__BOOT__ = {\n      member: {{ member | json }},\n      email: {{ results.me.members[0].email | json }}\n    };\n  </script>\n  <script type=\"module\" src=\"/static/admin.js?v={{ site.version }}\"></script>\n</body>\n</html>\n"
    }
  ]
}
