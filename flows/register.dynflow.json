{
  "format": "dynapi-flow",
  "version": 1,
  "exportedAt": "2026-09-08T00:00:00.000Z",
  "handle": {
    "slug": "register",
    "name": "Register",
    "enabled_cors": false,
    "allowed_origins": []
  },
  "routes": [
    {
      "path": "/register",
      "methods": [
        "POST"
      ],
      "cache": {
        "defaultTtl": 0
      },
      "flows": [
        {
          "handle": "register",
          "methods": [
            "POST"
          ]
        }
      ]
    }
  ],
  "flow": {
    "version": 2,
    "nodes": [
      {
        "id": "n_start",
        "type": "entry",
        "data": {}
      },
      {
        "id": "a_check",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "stop",
          "config": {
            "query": "query($q: String!) {\n  members(where: {email: {eq: $q}}, limit: 1) {\n    id\n  }\n}",
            "variables": {
              "q": "{{form.email}}"
            },
            "result_key": "m"
          }
        }
      },
      {
        "id": "c_taken",
        "type": "condition",
        "data": {
          "predicate": {
            "combinator": "and",
            "clauses": [
              {
                "field": "results.m.members",
                "operator": "ne",
                "value": "[]"
              }
            ]
          }
        }
      },
      {
        "id": "a_taken",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/register?taken=1",
            "status": 303
          }
        }
      },
      {
        "id": "a_create",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "stop",
          "config": {
            "query": "mutation($input: MemberInput!) {\n  createMember(input: $input) {\n    id\n  }\n}",
            "variables": {
              "input": {
                "email": "{{form.email}}",
                "password": "{{form.password}}",
                "name": "{{form.name}}"
              }
            },
            "secret_vars": [
              "password"
            ]
          }
        }
      },
      {
        "id": "a_fetch",
        "type": "action",
        "data": {
          "action_type": "graphql",
          "on_error": "continue",
          "config": {
            "query": "query($q: String!) {\n  members(where: {email: {eq: $q}}, limit: 1) {\n    id password\n  }\n}",
            "variables": {
              "q": "{{form.email}}"
            },
            "result_key": "m",
            "secret_vars": [
              "password"
            ]
          }
        }
      },
      {
        "id": "a_mail",
        "type": "action",
        "data": {
          "action_type": "send_email",
          "on_error": "stop",
          "config": {
            "to": [
              "{{form.email}}"
            ],
            "subject": "Подтверждение регистрации — каталог библиотеки",
            "body_template": "Здравствуйте, {{form.name}}!\n\nПодтвердите email по ссылке (действует 24 часа):\nhttps://biblio.dynapi.ru/verify?token={{ results.m.members[0].password | signed_token: results.m.members[0].id, \"verify\", 86400 }}\n\nЕсли вы не регистрировались в каталоге библиотеки — просто удалите это письмо.",
            "smtp": {
              "host": "mail.dynapi.ru",
              "port": 587,
              "username": "biblio@dynapi.ru",
              "password": "secret://biblio-smtp-password",
              "from": "biblio@dynapi.ru",
              "from_name": "Каталог библиотеки"
            }
          }
        }
      },
      {
        "id": "a_ok",
        "type": "action",
        "data": {
          "action_type": "redirect",
          "on_error": "continue",
          "config": {
            "location": "/login?check_email=1",
            "status": 303
          }
        }
      }
    ],
    "edges": [
      {
        "from": "n_start",
        "to": "a_check",
        "branch": ""
      },
      {
        "from": "a_check",
        "to": "c_taken",
        "branch": ""
      },
      {
        "from": "c_taken",
        "to": "a_taken",
        "branch": "then"
      },
      {
        "from": "c_taken",
        "to": "a_create",
        "branch": "else"
      },
      {
        "from": "a_create",
        "to": "a_fetch",
        "branch": ""
      },
      {
        "from": "a_fetch",
        "to": "a_mail",
        "branch": ""
      },
      {
        "from": "a_mail",
        "to": "a_ok",
        "branch": ""
      }
    ]
  },
  "queries": [],
  "templates": []
}
